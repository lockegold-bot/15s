#!name=Locket Custom Edition
#!desc=Crack By lin | Tùy chỉnh Video & Caption cá nhân.

[General]

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com

[Script]
# 1. Tùy chỉnh Feature, Video 36s & Caption cá nhân
locket_remote = type=http-response, pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-.*, script-path=https://raw.githubusercontent.com/lockegold-bot/15s/main/locket.js, requires-body=true, max-size=524288, timeout=60

# 2. Xóa ETag Header chống dính Cache (by lin)
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/lockegold-bot/15s/main/deleteHeader.js, timeout=60

# 3. Kích hoạt Gold (by lin)
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/lockegold-bot/15s/main/locket_sub.js, requires-body=true, max-size=-1, timeout=60
